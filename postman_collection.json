    {
      "name": "Authentication",
      "item": [
        {
          "name": "Firebase Social Auth (Google / Apple)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firebase_token\": \"{{firebase_token}}\",\n  \"email\": \"user@example.com\",\n  \"name\": \"John Doe\",\n  \"date_of_birth\": \"1995-05-20\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/firebase-auth/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "firebase-auth",
                ""
              ]
            },
            "description": "Authenticate using Firebase ID token (Google or Apple login). Automatically creates or links user and returns JWT access and refresh tokens."
          }
        },
        {
          "name": "User Signup (Email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"SecurePassword123!\",\n  \"confirm_password\": \"SecurePassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/signup/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "signup",
                ""
              ]
            },
            "description": "Register a new user account with Email/Password. Generates a 4-digit OTP sent to user's email."
          }
        },
        {
          "name": "Verify Signup OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"otp\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/verify-otp/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "verify-otp",
                ""
              ]
            },
            "description": "Verify 4-digit registration OTP to activate the user account."
          }
        },
        {
          "name": "Resend Signup OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/resend-otp/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "resend-otp",
                ""
              ]
            },
            "description": "Resend registration OTP to user's email if not received."
          }
        },
        {
          "name": "User Login (Email/Password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"SecurePassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "login",
                ""
              ]
